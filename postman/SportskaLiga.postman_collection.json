{
	"info": {
		"_postman_id": "7da15c42-6d2d-46ac-a133-337c2440829d",
		"name": "SportskaLiga API",
		"description": "Postman testovi za **SportskaLiga Web API** (Auth, Liga, Utakmice, Momčadi).\n\n**Pokretanje**\n1. Uvezi ovu kolekciju i okolinu (`SportskaLiga.lokalno` za `dotnet run`, `SportskaLiga.docker` za Docker).\n2. Baza i Admin moraju biti pokrenuti barem jednom (migracije + seed), zatim API.\n3. Pokreni cijelu kolekciju redom (Run collection) – zahtjevi spremaju tokene i Id-eve u varijable za sljedeće.\n\nTestovi za sobom čiste: upisani rezultat se poništava, a dodana momčad briše.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Jedinstven naziv testne momčadi, da ponovljeno pokretanje ne udari u 409.",
					"if (!pm.collectionVariables.get('nazivTest')) {",
					"    pm.collectionVariables.set('nazivTest', 'NK Postman ' + Date.now().toString().slice(-6));",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test('Poslužitelj nije vratio pogrešku 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
					"pm.test('Odgovor stiže u manje od 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
					"// Nakon zadnjeg zahtjeva naziv se briše, pa sljedeće pokretanje dobiva novi.",
					"if (pm.info.requestName.startsWith('DELETE /api/momcadi/{id} – već obrisana')) pm.collectionVariables.unset('nazivTest');"
				]
			}
		}
	],
