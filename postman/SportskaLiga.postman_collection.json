			"name": "Auth",
			"item": [
				{
					"name": "POST /api/auth/login – administrator (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status je 200 OK', () => pm.response.to.have.status(200));",
									"pm.test('Odgovor je JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
									"",
									"const o = pm.response.json();",
									"pm.test('Odgovor sadrži JWT i uloge', () => {",
									"    pm.expect(o.token).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);",
									"    pm.expect(o.tipTokena).to.eql('Bearer');",
									"    pm.expect(new Date(o.istjeceUtc).getTime()).to.be.above(Date.now());",
									"    pm.expect(o.uloge).to.include('Administrator');",
									"});",
									"pm.environment.set('adminToken', o.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
