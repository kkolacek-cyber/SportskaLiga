				{
					"name": "GET /api/tablica – aktivna sezona (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status je 200 OK', () => pm.response.to.have.status(200));",
									"",
									"const t = pm.response.json();",
									"pm.test('Tablica je za aktivnu sezonu', () => pm.expect(t.sezona.id).to.eql(Number(pm.collectionVariables.get('sezonaId'))));",
									"pm.test('Redovi su poredani po bodovima', () => {",
									"    pm.expect(t.redovi.length).to.be.above(1);",
									"    for (let i = 1; i < t.redovi.length; i++) {",
									"        pm.expect(t.redovi[i - 1].bodovi).to.be.at.least(t.redovi[i].bodovi);",
									"    }",
									"});",
									"pm.test('Bodovi = 3 x pobjede + neriješeno', () => t.redovi.forEach(r =>",
									"    pm.expect(r.bodovi).to.eql(r.pobjede * t.sezona.bodoviZaPobjedu + r.nerijeseno * t.sezona.bodoviZaNerijeseno)));",
									"pm.test('Forma ima najviše 5 znakova P/N/I', () => t.redovi.forEach(r => pm.expect(r.forma).to.match(/^[PNI]{0,5}$/)));"
								]
							}
						}
					],
