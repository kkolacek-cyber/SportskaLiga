									"",
									"const r = pm.response.json();",
									"pm.test('Raspored sadrži samo utakmice bez rezultata', () => r.stavke.forEach(u => pm.expect(u.status).to.not.eql('Odigrana')));",
									"pm.test('Raspored je kronološki', () => {",
									"    for (let i = 1; i < r.stavke.length; i++) pm.expect(new Date(r.stavke[i - 1].pocetak) <= new Date(r.stavke[i].pocetak)).to.be.true;",
									"});",
									"pm.test('Straničenje je ispravno', () => pm.expect(r.velicinaStranice).to.eql(100));",
									"const buduca = r.stavke.find(u => u.status === 'Zakazana' && new Date(u.pocetak) > new Date());",
									"pm.test('Postoji buduća utakmica', () => pm.expect(buduca).to.exist);",
