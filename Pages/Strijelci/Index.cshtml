@page
@* Lista strijelaca; igrači s istim brojem golova dijele poziciju. *@
@model SportskaLiga.Pages.Strijelci.IndexModel
@{
    ViewData["Title"] = "Strijelci";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1 class="h2 mb-0">Strijelci @Model.Sezona?.Naziv</h1>
    <partial name="_OdabirSezone" model="Model.Sezone" />
</div>

@if (Model.Lista.Count == 0)
{
    <p class="text-muted">U ovoj sezoni još nema postignutih golova.</p>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 tablica-lige">
                <thead>
                    <tr>
                        <th class="text-end" scope="col">#</th>
                        <th scope="col">Igrač</th>
                        <th scope="col">Momčad</th>
                        <th class="text-center" scope="col">Golovi</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Lista.Count; i++)
                    {
                        var s = Model.Lista[i];
                        // Pozicija se ispisuje samo kod prvog igrača s tim brojem golova (1., 2., –, 4.).
                        var istaKaoPrethodna = i > 0 && Model.Lista[i - 1].Pozicija == s.Pozicija;
                        <tr>
                            <td class="text-end">
                                @if (!istaKaoPrethodna)
                                {
                                    <span class="pozicija">@s.Pozicija</span>
                                }
                            </td>
                            <td class="fw-semibold">@s.Igrac</td>
                            <td><a asp-page="/Momcadi/Details" asp-route-id="@s.MomcadId" class="text-reset">@s.Momcad</a></td>
                            <td class="text-center"><span class="golovi">@s.Golovi</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="small text-muted mt-2">Autogolovi se ne pribrajaju strijelcu.</p>
}
