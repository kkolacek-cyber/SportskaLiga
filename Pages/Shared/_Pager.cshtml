@model SportskaLiga.ViewModels.PagerViewModel

@* Straničenje se prikazuje samo kad ima više od jedne stranice; veze čuvaju aktivne filtere (asp-all-route-data). *@
@if (Model.UkupnoStranica > 1)
{
    <nav aria-label="Straničenje">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Stranica <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="@Model.Page" asp-all-route-data="@Model.ZaStranicu(Model.Stranica - 1)">Prethodna</a>
            </li>

            @* null znači tri točkice između udaljenih stranica. *@
            @foreach (var broj in Model.Prikazane())
            {
                if (broj is null)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else
                {
                    <li class="page-item @(broj == Model.Stranica ? "active" : "")" aria-current="@(broj == Model.Stranica ? "page" : null)">
                        <a class="page-link" asp-page="@Model.Page" asp-all-route-data="@Model.ZaStranicu(broj.Value)">@broj</a>
                    </li>
                }
            }

            <li class="page-item @(Model.Stranica >= Model.UkupnoStranica ? "disabled" : "")">
                <a class="page-link" asp-page="@Model.Page" asp-all-route-data="@Model.ZaStranicu(Model.Stranica + 1)">Sljedeća</a>
            </li>
        </ul>
    </nav>
}
