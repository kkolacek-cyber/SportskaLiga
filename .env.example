# Primjer varijabli okruženja za docker-compose.
# .env datoteka je OPCIONALNA: docker-compose.yml ima zadane DEMO vrijednosti pa
# `docker compose up --build` radi i bez nje. Za vlastite vrijednosti: kopiraj ovu
# datoteku u `.env` i izmijeni je. Stvarne lozinke i tajne se NIKADA ne commitaju.
#
# Pažnja: PostgreSQL primjenjuje POSTGRES_PASSWORD samo pri prvom stvaranju volumena.
# Ako lozinku promijeniš kasnije, pokreni `docker compose down -v` (briše podatke baze).
# Lozinka ne smije sadržavati znak ";" jer se ugrađuje u connection string.

# --- Baza podataka (PostgreSQL) ---
POSTGRES_DB=sportskaliga
POSTGRES_USER=liga
POSTGRES_PASSWORD=liga_dev_password
# Port baze izložen na računalu (za dotnet run / dotnet ef izvan Dockera)
DB_PORT=5432

# --- Portovi aplikacija na računalu ---
PORTAL_PORT=8081
ADMIN_PORT=8082
API_PORT=8083

# --- Okruženje ---
# Production (zadano) ili Development (detaljne greške)
ASPNETCORE_ENVIRONMENT=Production

# --- Testni korisnici koje seed stvara pri prvom pokretanju (DEMO vrijednosti) ---
SEED_ADMIN_EMAIL=admin@liga.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_DELEGAT_EMAIL=delegat@liga.local
SEED_DELEGAT_PASSWORD=Delegat123!

# --- JWT za Web API (POST /api/auth/login) ---
# Ključ za potpisivanje tokena: najmanje 32 znaka, inače se API ne podiže.
# Ovo je samo DEMO vrijednost; za stvarnu uporabu generiraj vlastitu (npr. `openssl rand -base64 48`).
JWT_KEY=demo-jwt-key-only-for-local-development-0123456789abcdef
JWT_ISSUER=sportskaliga-api
JWT_AUDIENCE=sportskaliga-clients
JWT_EXPIRY_MINUTES=60
