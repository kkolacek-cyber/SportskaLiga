  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportskaLiga.Data\SportskaLiga.Data.csproj" />
    <ProjectReference Include="..\SportskaLiga.Domain\SportskaLiga.Domain.csproj" />
  </ItemGroup>

</Project>
