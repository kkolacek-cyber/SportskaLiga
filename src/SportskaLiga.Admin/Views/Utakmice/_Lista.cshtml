@* HTML fragment s tablicom utakmica; vraća ga akcija Lista, a utakmice.js ga umeće u stranicu. *@
@model UtakmiceListaViewModel
@{
    var rezultat = Model.Rezultat;
    var sada = DateTime.UtcNow;
    var pager = new PagerViewModel
    {
        Stranica = rezultat.Stranica,
        UkupnoStranica = rezultat.UkupnoStranica,
        Kontroler = "Utakmice",
        Akcija = "Index"
    };
}

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <span>Ukupno: <strong>@rezultat.UkupnoStavki</strong></span>
        <span class="text-muted small">Stranica @rezultat.Stranica od @Math.Max(rezultat.UkupnoStranica, 1)</span>
    </div>

    @if (rezultat.Items.Count == 0)
    {
        <div class="card-body text-muted">Nema utakmica koje odgovaraju filtrima.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Kolo</th>
                        <th>Početak</th>
                        <th class="text-end">Domaćin</th>
                        <th class="text-center">Rezultat</th>
                        <th>Gost</th>
                        <th>Status</th>
                        <th class="d-none d-xl-table-cell">Sudac / delegat</th>
                        <th class="text-end">Radnje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in rezultat.Items)
                    {
                        var cekaRezultat = u.Status == StatusUtakmice.Zakazana && u.Pocetak < sada;
                        var smijeUpisati = Model.JeAdministrator || (u.DelegatId is not null && u.DelegatId == Model.KorisnikId);
                        <tr>
                            <td>@(u.Kolo).</td>
                            <td class="text-nowrap">@Kalendar.ULokalno(u.Pocetak).ToString("dd.MM.yyyy. HH:mm")</td>
                            <td class="text-end fw-semibold">@u.Domacin?.Naziv</td>
                            <td class="text-center"><span class="rezultat">@u.Rezultat</span></td>
                            <td class="fw-semibold">@u.Gost?.Naziv</td>
                            <td><status-badge value="@u.Status" ceka-rezultat="@cekaRezultat" /></td>
                            <td class="d-none d-xl-table-cell small text-muted">
                                @(u.Sudac?.PunoIme ?? "–") /
                                @(u.DelegatId is not null && Model.Delegati.TryGetValue(u.DelegatId, out var delegat) ? delegat : "–")
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Detalji</a>
                                @if (smijeUpisati && u.Status != StatusUtakmice.Odgodena && u.Pocetak < sada)
                                {
                                    <a asp-action="Rezultat" asp-route-id="@u.Id"
                                       class="btn btn-sm @(cekaRezultat ? "btn-warning" : "btn-outline-primary")">@(cekaRezultat ? "Upiši rezultat" : "Ispravi")</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (rezultat.UkupnoStranica > 1)
    {
        <div class="card-footer">
            <partial name="_Pager" model="pager" />
        </div>
    }
</div>
