@* Detalji momčadi: podaci, igrači po broju dresa (1:N) i sezone u kojima sudjeluje (M:N). *@
@model Momcad
@{
    ViewData["Title"] = Model.Naziv;
    var admin = User.IsInRole(Roles.Administrator);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Momčadi</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Naziv</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Model.Naziv</h1>
    @if (admin)
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Uredi</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Obriši</a>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Grad</dt>
                    <dd class="col-7">@Model.Grad</dd>
                    <dt class="col-5">Igralište</dt>
                    <dd class="col-7">@(Model.Igraliste ?? "–")</dd>
                    <dt class="col-5">Osnovana</dt>
                    <dd class="col-7">@(Model.GodinaOsnutka?.ToString() ?? "–")</dd>
                    <dt class="col-5">Kontakt</dt>
                    <dd class="col-7 text-break">@(Model.KontaktEmail ?? "–")</dd>
                </dl>
            </div>
        </div>
        <div class="card">
            <div class="card-header">Sezone</div>
            @if (Model.Sezone.Count == 0)
            {
                <div class="card-body text-muted">Momčad još nije prijavljena ni u jednu sezonu.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.Sezone.OrderByDescending(p => p.Sezona?.DatumPocetka))
                    {
                        <li class="list-group-item">
                            @if (admin)
                            {
                                <a asp-controller="Sezone" asp-action="Details" asp-route-id="@p.SezonaId" class="text-decoration-none">@p.Sezona?.Naziv</a>
                            }
                            else
                            {
                                @p.Sezona?.Naziv
                            }
                            <span class="text-muted small">· prijavljena @p.DatumPrijave.ToString("dd.MM.yyyy.")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Igrači (@Model.Igraci.Count)</span>
                @if (admin)
                {
                    <a asp-controller="Igraci" asp-action="Create" asp-route-momcadId="@Model.Id" class="btn btn-sm btn-primary">Registriraj igrača</a>
                }
            </div>
            @if (Model.Igraci.Count == 0)
            {
                <div class="card-body text-muted">Momčad još nema registriranih igrača.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-end">Br.</th>
                                <th>Igrač</th>
                                <th>Pozicija</th>
                                <th class="d-none d-sm-table-cell">Rođen</th>
                                @if (admin)
                                {
                                    <th class="text-end">Radnje</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Igraci)
                            {
                                <tr>
                                    <td class="text-end fw-bold">@i.BrojDresa</td>
                                    <td>@i.PunoIme</td>
                                    <td><status-badge value="@i.Pozicija" /></td>
                                    <td class="d-none d-sm-table-cell">@i.DatumRodenja.ToString("dd.MM.yyyy.")</td>
                                    @if (admin)
                                    {
                                        <td class="text-end text-nowrap">
                                            <a asp-controller="Igraci" asp-action="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary">Uredi</a>
                                            <a asp-controller="Igraci" asp-action="Delete" asp-route-id="@i.Id" class="btn btn-sm btn-outline-danger">Obriši</a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
