@* Potvrda brisanja momčadi (samo Administrator). Momčad s igračima, prijavama ili utakmicama baza ne dopušta obrisati (Restrict). *@
@model Momcad
@{
    ViewData["Title"] = "Brisanje momčadi";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Momčadi</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Naziv</a></li>
        <li class="breadcrumb-item active" aria-current="page">Brisanje</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-body">
                <h1 class="h4 text-danger">Obrisati momčad "@Model.Naziv"?</h1>
                @if (Model.Igraci.Count > 0 || Model.Sezone.Count > 0)
                {
                    <div class="alert alert-warning">
                        Momčad ima igrače (@Model.Igraci.Count) i/ili prijave u sezone (@Model.Sezone.Count), pa je baza neće dopustiti obrisati.
                        Najprije uklonite igrače i odjavite momčad iz sezona.
                    </div>
                }
                <p class="mb-3">Ova radnja se ne može poništiti.</p>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Obriši</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Odustani</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
