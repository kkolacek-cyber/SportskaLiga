@* Potvrda brisanja suca. Utakmice koje je sudio ostaju, samo bez suca (SetNull u bazi). *@
@model Sudac
@{
    ViewData["Title"] = "Brisanje suca";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Suci</a></li>
        <li class="breadcrumb-item active" aria-current="page">Brisanje</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-body">
                <h1 class="h4 text-danger">Obrisati suca @Model.PunoIme?</h1>
                <p>Utakmice koje su mu dodijeljene ostaju, ali bez suca. Ova radnja se ne može poništiti.</p>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Obriši</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
