@* Isti obrazac za dodavanje (Id = 0) i uređivanje sezone. Kraj sezone provjerava i [NakonDatuma] na klijentu. *@
@model SezonaFormViewModel
@{
    var nova = Model.Id == 0;
    ViewData["Title"] = nova ? "Nova sezona" : "Uređivanje sezone";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Sezone</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(nova ? "Dodavanje" : "Uređivanje")</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-7 col-xl-5">
        <div class="card">
            <div class="card-body">
                <h1 class="h4 mb-3">@ViewData["Title"]</h1>

                <form method="post" novalidate>
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Naziv" class="form-label"></label>
                            <input asp-for="Naziv" class="form-control" autofocus />
                            <span asp-validation-for="Naziv" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DatumPocetka" class="form-label"></label>
                            <input asp-for="DatumPocetka" class="form-control" />
                            <span asp-validation-for="DatumPocetka" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DatumZavrsetka" class="form-label"></label>
                            <input asp-for="DatumZavrsetka" class="form-control" />
                            <span asp-validation-for="DatumZavrsetka" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BodoviZaPobjedu" class="form-label"></label>
                            <input asp-for="BodoviZaPobjedu" class="form-control" />
                            <span asp-validation-for="BodoviZaPobjedu" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BodoviZaNerijeseno" class="form-label"></label>
                            <input asp-for="BodoviZaNerijeseno" class="form-control" />
                            <span asp-validation-for="BodoviZaNerijeseno" class="text-danger"></span>
                        </div>
                        <div class="col-12 form-text mt-1">
                            Tablica se ne sprema nego računa iz utakmica, pa promjena bodovanja odmah vrijedi za cijelu sezonu.
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Spremi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
