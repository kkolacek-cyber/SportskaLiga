@* Popis sezona; aktivnu sezonu prikazuju portal i API kad sezona nije zadana. *@
@model IReadOnlyList<Sezona>
@{
    ViewData["Title"] = "Sezone";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Sezone</h1>
    <a asp-action="Create" class="btn btn-primary">Dodaj sezonu</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">Još nema sezona.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sezona</th>
                        <th>Trajanje</th>
                        <th>Bodovanje (P / N)</th>
                        <th class="text-end">Radnje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@s.Id" class="fw-semibold text-decoration-none">@s.Naziv</a>
                                @if (s.Aktivna)
                                {
                                    <span class="badge badge-uloga ms-1">aktivna</span>
                                }
                            </td>
                            <td>@s.DatumPocetka.ToString("dd.MM.yyyy.") &ndash; @s.DatumZavrsetka.ToString("dd.MM.yyyy.")</td>
                            <td>@s.BodoviZaPobjedu / @s.BodoviZaNerijeseno</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Detalji</a>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Uredi</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
