@* Potvrda brisanja sezone: kaskadno se brišu prijave momčadi, utakmice i golovi te sezone. *@
@model SezonaDetailsViewModel
@{
    ViewData["Title"] = "Brisanje sezone";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Sezone</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Sezona.Id">@Model.Sezona.Naziv</a></li>
        <li class="breadcrumb-item active" aria-current="page">Brisanje</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-body">
                <h1 class="h4 text-danger">Obrisati sezonu @Model.Sezona.Naziv?</h1>
                <p>
                    Zajedno sa sezonom brišu se prijave momčadi (@Model.Momcadi.Count) i sve utakmice (@Model.BrojUtakmica,
                    od toga odigranih @Model.BrojOdigranih) s golovima. Same momčadi i igrači ostaju.
                </p>
                <p class="mb-3">Ova radnja se ne može poništiti.</p>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Sezona.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Obriši</button>
                        <a asp-action="Details" asp-route-id="@Model.Sezona.Id" class="btn btn-outline-secondary">Odustani</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
