<Project Sdk="Microsoft.NET.Sdk">

  <!-- Data je ujedno startup projekt za "dotnet ef" (ima design-time factory); biblioteka inače ne generira
       runtimeconfig.json koji alat treba za pokretanje. -->
  <PropertyGroup>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <!-- IServiceCollection/IConfiguration za AddSportskaLigaData i ASP.NET Core Identity tipove. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportskaLiga.Domain\SportskaLiga.Domain.csproj" />
  </ItemGroup>

  <!-- Bez Version: verzije su u Directory.Packages.props (središnje upravljanje paketima). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
